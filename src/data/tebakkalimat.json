[
  {
    "index": 0,
    "soal": "Como un niño...perdiendo a su madre",
    "jawaban": "pollo "
  },
  {
    "index": 1,
    "soal": "Como agua en... taro",
    "jawaban": "hojas "
  },
  {
    "index": 2,
    "soal": "La vida se concibe... la muerte se concibe en la tierra.",
    "jawaban": "personalizado "
  },
  {
    "index": 3,
    "soal": "Lejos, cerca del corazón",
    "jawaban": "ojos"
  },
  {
    "index": 4,
    "soal": "No hay ratán... está bien.",
    "jawaban": "raíz "
  },
  {
    "index": 5,
    "soal": "Las deudas de oro pueden ser pagadas, las deudas... llevadas a la muerte.",
    "jawaban": "Budí "
  },
  {
    "index": 6,
    "soal": "Hay camarones detrás... ",
    "jawaban": "piedra"
  },
  {
    "index": 7,
    "soal": "Hay... hay hormigas.",
    "jawaban": "azúcar "
  },
  {
    "index": 8,
    "soal": "Hay... hay un incendio",
    "jawaban": "fumar "
  },
  {
    "index": 9,
    "soal": "Como... y el cielo",
    "jawaban": "tierra "
  },
  {
    "index": 10,
    "soal": "En lugar de llover en el país de otra persona, es mejor que llueva piedras en el propio país.",
    "jawaban": "oro "
  },
  {
    "index": 11,
    "soal": "Dado... pidió un corazón",
    "jawaban": "corazón "
  },
  {
    "index": 12,
    "soal": " ... agujero de la tapa del agujero",
    "jawaban": "cavar "
  },
  {
    "index": 13,
    "soal": "Pollo calentito... calentito",
    "jawaban": "mierda "
  },
  {
    "index": 14,
    "soal": "Sea ahorrativo, diligente e inteligente",
    "jawaban": "rico"
  },
  {
    "index": 15,
    "soal": " ... preguntando extraviado en el camino",
    "jawaban": "vergüenza "
  },
  {
    "index": 16,
    "soal": " ... se ha vuelto papilla",
    "jawaban": "Arroz "
  },
  {
    "index": 17,
    "soal": "El rodaje de ser amado... ha llegado",
    "jawaban": "ulam "
  },
  {
    "index": 18,
    "soal": "Como la ciencia... cuanto más contienes, más te doblas",
    "jawaban": "arroz "
  },
  {
    "index": 19,
    "soal": "Tong... el sonido es fuerte",
    "jawaban": "vacío"
  },
  {
    "index": 20,
    "soal": "Armas... ",
    "jawaban": "señor"
  },
  {
    "index": 21,
    "soal": "Sin marfil... sin grietas",
    "jawaban": "cual"
  },
  {
    "index": 22,
    "soal": "No hay ratán, ni siquiera raíces... ",
    "jawaban": "entonces"
  },
  {
    "index": 23,
    "soal": "Demandarlo... hasta llegar a China",
    "jawaban": "ciencia"
  },
  {
    "index": 24,
    "soal": "No hay nada... hay raíces.",
    "jawaban": "ratán"
  },
  {
    "index": 25,
    "soal": "Grande... que un poste",
    "jawaban": "clavijas"
  },
  {
    "index": 26,
    "soal": "En lo profundo de los ojos... en el corazón.",
    "jawaban": "cerrar"
  },
  {
    "index": 27,
    "soal": "Por más inteligente que seas... salta, a veces tú también te caes",
    "jawaban": "ardilla"
  },
  {
    "index": 28,
    "soal": "Destruido... contenido en la tierra, las buenas acciones también se recuerdan",
    "jawaban": "cuerpo"
  },
  {
    "index": 29,
    "soal": "Unidos... divididos caemos",
    "jawaban": "firme"
  },
  {
    "index": 30,
    "soal": "Clavijas más grandes que... ",
    "jawaban": "poste"
  },
  {
    "index": 31,
    "soal": "Se volvió dulce... tirado a la basura",
    "jawaban": "sepah"
  },
  {
    "index": 32,
    "soal": "Salva la base rica,... la base inteligente",
    "jawaban": "diligente"
  },
  {
    "index": 33,
    "soal": "Vive... no quiero/quiero morir",
    "jawaban": "reacio"
  },
  {
    "index": 34,
    "soal": "Porque una mota de tilapia,... un pote de leche",
