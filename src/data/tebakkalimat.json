  },
  {
    "index": 70,
    "soal": " ... piedra escondida a mano",
    "jawaban": "tirar"
  },
  {
    "index": 71,
    "soal": " ... plumas de pollo",
    "jawaban": "comadreja"
  },
  {
    "index": 72,
    "soal": "No hay nada... que no esté agrietado.",
    "jawaban": "marfil"
  },
  {
    "index": 73,
    "soal": "Mayor... cuanto mayor te haces, más te vuelves",
    "jawaban": "caladio"
  },
  {
    "index": 74,
    "soal": "Mismo peso..., ligero y fácil de transportar",
    "jawaban": "llevado"
  },
  {
    "index": 75,
    "soal": "Como... extrañar la luna",
    "jawaban": "volver"
  },
  {
    "index": 76,
    "soal": "Leche... con agua tubárica",
    "jawaban": "respondió"
  },
  {
    "index": 77,
    "soal": "Como un pájaro en... ",
    "jawaban": "jaula"
  },
  {
    "index": 78,
    "soal": "Aprender demasiado como una flor... no funciona",
    "jawaban": "flor"
  },
  {
    "index": 79,
    "soal": "Caravana de perros ladrando... ",
    "jawaban": "pasó"
  },
  {
    "index": 80,
    "soal": "El mundo no... Moringa se va",
    "jawaban": "ancho"
  },
  {
    "index": 81,
    "soal": "Los elefantes en... los ojos son invisibles, las hormigas al otro lado del mar son visibles",
    "jawaban": "cubrir"
  },
  {
    "index": 82,
    "soal": "Un elefante muere dejando colmillos,... muere dejando rayas",
    "jawaban": "tigre"
  },
  {
    "index": 83,
    "soal": "Palmeó el agua en la bandeja, salpicó la cara ... ",
    "jawaban": "tu mismo"
  },
  {
    "index": 84,
    "soal": "Como nuez de areca... dos",
    "jawaban": "dividir"
  },
  {
    "index": 85,
    "soal": "Como agua en... taro",
    "jawaban": "hojas"
  },
  {
    "index": 86,
    "soal": "De arbusto a... ",
    "jawaban": "matorral"
  },
  {
    "index": 87,
    "soal": "En lugar de vivir en el espejo..., es mejor morir en la tierra.",
    "jawaban": "carcasa"
  },
  {
    "index": 88,
    "soal": "Se acabó... todo está tirado a la basura",
    "jawaban": "dulce"
  },
  {
    "index": 89,
    "soal": "Lejos, cerca del corazón",
    "jawaban": "ojos"
  },
  {
    "index": 90,
    "soal": "¿Qué significa el corazón... montañas, tus manos no pueden alcanzarlas?",
    "jawaban": "abrazo"
  },
  {
    "index": 91,
    "soal": "Vergüenza... perdido en el camino",
    "jawaban": "preguntó"
  },
  {
    "index": 92,
    "soal": "Mientras...bebiendo agua",
    "jawaban": "buceo"
  },
  {
    "index": 93,
    "soal": "Está el dinero de mi hermano en..., no hay dinero de mi hermano flotando por ahí.",
    "jawaban": "cariño"
  },
  {
    "index": 94,
    "soal": "La leche se responde con... ",
    "jawaban": "agua tubárica"
  },
  {
    "index": 95,
    "soal": "Locos, olvídate de... ",
    "jawaban": "la piel"
  },
  {
    "index": 96,
    "soal": " ... saliva",
    "jawaban": "lamer"
  },
  {
    "index": 97,
    "soal": " ... caza/ropa de oveja",
    "jawaban": "lobo"
  },
  {
    "index": 98,
    "soal": "La lengua no... ",
    "jawaban": "huesudo"
  },
  {
    "index": 99,
    "soal": "Mientras la vida todavía esté en el cuerpo.",
    "jawaban": "nacimiento"
  },
  {
    "index": 100,
    "soal": "No... en agua turbia",
    "jawaban": "mirate en el espejo"
  },
  {
    "index": 101,
    "soal": "Mientras las hojas amarillas del coco no..., entonces siempre te perseguiré para conseguir tu amor.",
    "jawaban": "curvo"
  },
  {
    "index": 102,
    "soal": "Como comer... simalakama",
    "jawaban": "fruta"
  }
