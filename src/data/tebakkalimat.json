  },
  {
    "index": 35,
    "soal": "Otro campo es otro saltamontes, otro... otro pez",
    "jawaban": "profundo"
  },
  {
    "index": 36,
    "soal": "Lame... a ti mismo",
    "jawaban": "escupir"
  },
  {
    "index": 37,
    "soal": "Pescando en el agua... ",
    "jawaban": "nublado"
  },
  {
    "index": 38,
    "soal": " ... comer plantas",
    "jawaban": "valla"
  },
  {
    "index": 39,
    "soal": "Como un caballo... desde el borde",
    "jawaban": "apagado"
  },
  {
    "index": 40,
    "soal": "El agua ondula como señal... ",
    "jawaban": "profundo"
  },
  {
    "index": 41,
    "soal": "El gallo cantó hoy... ",
    "jawaban": "tarde"
  },
  {
    "index": 42,
    "soal": "Como agua en una hoja... ",
    "jawaban": "taro"
  },
  {
    "index": 43,
    "soal": "Como... en un caparazón",
    "jawaban": "rana"
  },
  {
    "index": 44,
    "soal": "Donde está la tierra... allí se sostiene el cielo",
    "jawaban": "pisar"
  },
  {
    "index": 45,
    "soal": "Profesora hace pis de pie,... hace pis corriendo",
    "jawaban": "estudiante"
  },
  {
    "index": 46,
    "soal": "Chiles pequeños... ",
    "jawaban": "cayena"
  },
  {
    "index": 47,
    "soal": "Ha sido... aplastado por las escaleras.",
    "jawaban": "cayó"
  },
  {
    "index": 48,
    "soal": "Mientras buceas... agua",
    "jawaban": "beber"
  },
  {
    "index": 49,
    "soal": "Como pierde una gallina... ",
    "jawaban": "padre"
  },
  {
    "index": 50,
    "soal": "Ten un paraguas listo antes... ",
    "jawaban": "lluvia"
  },
  {
    "index": 51,
    "soal": "Poco a poco, con el tiempo se va convirtiendo... ",
    "jawaban": "colina"
  },
  {
    "index": 52,
    "soal": " ... murió en un granero de arroz",
    "jawaban": "rata "
  },
  {
    "index": 53,
    "soal": " ... abajo embotar arriba",
    "jawaban": "Afilado"
  },
  {
    "index": 54,
    "soal": "... es dinero",
    "jawaban": "tiempo"
  },
  {
    "index": 55,
    "soal": "La tormenta...pasó",
    "jawaban": "seguro"
  },
  {
    "index": 56,
    "soal": " ... en una manta",
    "jawaban": "enemigo"
  },
  {
    "index": 57,
    "soal": "Maíz de un año,... un chorrito de nuez de areca",
    "jawaban": "sangre"
  },
  {
    "index": 58,
    "soal": "Como... en una jaula",
    "jawaban": "pájaro"
  },
  {
    "index": 59,
    "soal": "Hay dinero ahí... ",
    "jawaban": "bienes"
  },
  {
    "index": 60,
    "soal": "El agua... señal de que no hay profundidad",
    "jawaban": "ondulación"
  },
  {
    "index": 61,
    "soal": "Como... reducido a la mitad",
    "jawaban": "nuez de areca"
  },
  {
    "index": 62,
    "soal": "Silencio... lenguaje",
    "jawaban": "mil"
  },
  {
    "index": 63,
    "soal": "Los tigres mueren dejando atrás..., los elefantes mueren dejando atrás colmillos",
    "jawaban": "rayado"
  },
  {
    "index": 64,
    "soal": " ... olvídate de la piel",
    "jawaban": "nueces "
  },
  {
    "index": 65,
    "soal": " ... piedra escondida a mano",
    "jawaban": "tirar "
  },
  {
    "index": 66,
    "soal": "El agua... se lava",
    "jawaban": "cálmate"
  },
  {
    "index": 67,
    "soal": "Vino no recogido... no entregado",
    "jawaban": "vete a casa"
  },
  {
    "index": 68,
    "soal": "De... lo claro no correrá agua turbia",
    "jawaban": "lago"
  },
  {
    "index": 69,
    "soal": " ... el cuerpo contenido en la tierra de la sabiduría también es bueno para recordar",
